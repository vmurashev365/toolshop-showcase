{
  "name": "toolshop-qa-framework-showcase",
  "version": "1.0.0",
  "description": "Risk-based QA and hybrid test automation suite (Playwright Test + Cucumber BDD) for Practice Software Testing (Toolshop)",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "bdd:dry": "cucumber-js --profile all --dry-run",
    "pw:list": "playwright test --list --reporter=list",
    "test:api": "cross-env PW_REPORT_DIR=reports/pw-api playwright test --project=api-margin-security",
    "test:mobile": "cross-env PW_REPORT_DIR=reports/pw-mobile playwright test --project=mobile-webkit --project=mobile-chromium",
    "test:ux": "cross-env PW_REPORT_DIR=reports/pw-ux playwright test --project=ux-guards",
    "test:discrepancies:api": "cross-env PW_REPORT_DIR=reports/pw-discrepancies playwright test --project=known-discrepancies-api",
    "pretest:bdd": "node scripts/clean-report-dir.js reports/bdd",
    "test:bdd": "cucumber-js",
    "test:with-bugs": "cross-env TARGET_ENV=with-bugs PW_REPORT_DIR=reports/pw-with-bugs playwright test --project=api-margin-security",
    "test:pr-gate": "npm run typecheck && npm run bdd:dry && npm run test:api && npm run test:bdd",
    "clean": "node -e \"const { rmSync } = require('node:fs'); for (const dir of ['reports', 'playwright-report', 'test-results', 'screenshots', 'videos', 'har']) rmSync(dir, { recursive: true, force: true });\""
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@cucumber/cucumber": "13.3.0",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "cross-env": "^10.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
