{
  "name": "toolshop-qa-framework-showcase",
  "version": "1.0.0",
  "description": "Risk-based QA and hybrid test automation suite (Playwright Test + Cucumber BDD) for Practice Software Testing (Toolshop)",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "typecheck": "node node_modules/typescript-native/bin/tsc --noEmit",
    "bdd:dry": "cross-env REPORT_DIR=reports/bdd-dry-run cucumber-js --profile all --dry-run",
    "pw:list": "playwright test --list --reporter=list",
    "test:api": "node scripts/run-tests.js api",
    "test:mobile": "node scripts/run-tests.js mobile",
    "test:ux": "node scripts/run-tests.js ux",
    "test:discrepancies:api": "node scripts/run-tests.js discrepancies",
    "test:bdd": "node scripts/run-tests.js bdd",
    "test:with-bugs": "node scripts/run-tests.js with-bugs",
    "test:pr-gate": "node scripts/run-tests.js pr-gate",
    "report:open": "node scripts/report-open.js",
    "test:report-opening": "node --test tests/integration/report-opening.test.js",
    "clean": "node -e \"const { rmSync } = require('node:fs'); for (const dir of ['reports', 'playwright-report', 'test-results', 'screenshots', 'videos', 'har']) rmSync(dir, { recursive: true, force: true });\"",
    "lint": "eslint playwright.config.ts scripts src tests",
    "test:unit": "node --import tsx --test tests/unit/*.test.ts",
    "check:static": "npm run lint && npm run typecheck && npm run test:unit && npm run bdd:dry && npm run pw:list",
    "check:local": "node --import tsx scripts/check-local-toolshop.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@cucumber/cucumber": "13.3.0",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "cross-env": "^10.0.0",
    "eslint": "10.15.0",
    "eslint-plugin-playwright": "2.12.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "typescript-native": "npm:typescript@7.0.2"
  }
}
